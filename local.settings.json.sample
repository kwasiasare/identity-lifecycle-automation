    "EVENTS_QUEUE_NAME": "identity-events",
    "INBOUND_CONTAINER_NAME": "identity-events-inbound",
    "IDEMPOTENCY_TABLE_NAME": "IdempotencyLedger",

    "LOGS_INGESTION_ENDPOINT": "",
    "LOGS_DCR_IMMUTABLE_ID": "",
    "LOGS_STREAM_NAME": "Custom-IdentityLifecycleAudit_CL",
    "LOCAL_AUDIT_LOG_PATH": "audit-fallback.log",

    "LEAVER_DEFERRED_DELETE_DAYS": "30",
    "DRY_RUN": "true",

    "AZURE_CLIENT_ID": ""
  }
